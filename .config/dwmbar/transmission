#!/bin/bash


icon="󰚌"

toggle_list () {
	ROWS=$(transmission-remote -l | wc -l)
	if pidof watch; then
    killall watch 
  else
    setsid -f falacritty -o window.dimensions.columns=170 -o window.dimensions.lines="$ROWS"\
      -e watch -d -n 1 -t -c transmission-remote -l
  fi
}


case $BUTTON in
        1) (toggle_list &> /dev/null &) &;;
	3) setsid -f torrent_dmenu;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0";;
esac

# Si el transmission está prendido, muestra el icono.
id=$(pgrep transmission-da)
[ -n "$id" ] && printf "%s " "$icon"; 

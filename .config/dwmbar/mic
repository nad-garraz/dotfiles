#!/bin/bash

# micen dwmbar
icon=""
icon_mute="" 

command(){
  pamixer --source 5 "$1";
}
killCommand(){
  pkill -RTMIN+17 dwmblocks;
}

mic_volume="$(command --get-volume)%"

mic_muted=$(command --get-mute | tr -d "\n")

if [ "$mic_muted" == "true" ]
then
	printf "%s " "$icon_mute" | tr -d "\n"
else
	printf "%s%s " "$icon" "$mic_volume" | tr -d "\n"
fi

case $BUTTON in
	1) command -t && killCommand;;
	4) command -i 2 && killCommand;;
	5) command -d 2 && killCommand;;
	6) "$TERMINAL" -e "$EDITOR" "$0";;
esac

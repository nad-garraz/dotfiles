cmd open ${{
    case "$f" in
        *.vim) alacritty -e nvim -S "$f" & disown -h &;;
        *.mp4|*.mp3|*.opus|*.mkv) mpv --title=mpvfloat "$f" &;;
        *.pdf) zathura "$f" & ;;
        *.jpg|*.jpeg) sxiv "$f" & ;;
        *) alacritty -e $EDITOR "$f" &;;
    esac
}}

cmd share ${{
        dragon-drop -x "$f"
        }}
